diff --git i/src/llama-quant.cpp w/src/llama-quant.cpp
index fd6e787bd..ab3dfd474 100644
--- i/src/llama-quant.cpp
+++ w/src/llama-quant.cpp
@@ -293,6 +293,15 @@ static bool tensor_allows_quantization(const llama_model_quantize_params * param
     // quantize only 2D and 3D tensors (experts)
     if (ggml_n_dims(tensor) < 2) return false;
 
+    // image diffusion models (MiniMax-H3): quantize 2D linears only,
+    // keep all other tensors in source precision (cf. City96 ComfyUI-GGUF)
+    if (arch == LLM_ARCH_MINIMAX_H3) {
+        return ggml_n_dims(tensor) == 2 &&
+            ggml_get_name(tensor) &&
+            std::string(ggml_get_name(tensor)).rfind("weight") ==
+                std::string(ggml_get_name(tensor)).size() - 6;
+    }
+
     const std::string name = ggml_get_name(tensor);
 
     // This used to be a regex, but <regex> has an extreme cost to compile times.
diff --git i/src/models/models.h w/src/models/models.h
index cefaf56eb..a11638cbc 100644
--- i/src/models/models.h
+++ w/src/models/models.h
@@ -2336,3 +2336,19 @@ struct llama_model_step35 : public llama_model_base {
 
     std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params & params) const override;
 };
+
+// Image diffusion transformer (MiniMax-H3, ComfyUI-GGUF format).
+// Quantize-only support: there is no inference graph for this arch.
+// The quantizer only needs arch identity + generic tensor iteration.
+struct llama_model_minimax_h3 : public llama_model_base {
+    llama_model_minimax_h3(const struct llama_model_params & params) : llama_model_base(params) {}
+    void load_hparams(llama_model_loader &) override {
+        // no LLM hparams in image GGUFs; quantize path must not require them
+    }
+    void load_arch_hparams(llama_model_loader &) override {}
+    void load_arch_tensors(llama_model_loader &) override {}
+
+    std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params &) const override {
+        return nullptr;
+    }
+};
